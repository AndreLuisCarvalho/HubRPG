# Copie para backend/.env (fica fora do Git) e preencha.

# Login com o Google: o "ID do cliente" OAuth (Google Cloud Console → APIs e serviços → Credenciais).
# Em "Origens JavaScript autorizadas" ponha http://localhost:5173 e o endereço do site na Vercel.
GOOGLE_CLIENT_ID=

# Quantas contas Google o site aceita no total (padrão 10). Quem já tem conta continua entrando.
LIMITE_CONTAS=10

# Assina o token de login. Na Vercel é obrigatório: um texto longo e aleatório.
SESSAO_SEGREDO=
